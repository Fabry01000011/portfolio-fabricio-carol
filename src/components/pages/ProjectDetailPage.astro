---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../project/ArchitectureDiagram.astro';
import RepoBadge from '../project/RepoBadge.astro';
import Gallery from '../ui/Gallery.astro';
import TechChip from '../ui/TechChip.astro';
import Button from '../ui/Button.astro';

import { useTranslations, localePath } from '../../i18n';
import {
  localiseProject,
  getProjects,
  getProjectNeighbours,
  type Project,
} from '../../lib/content';
import { resolveTechs, groupByLayer } from '../../data/tech';
import { projectSchema, breadcrumbSchema } from '../../lib/schema';
import { ArrowLeft, ArrowRight, ExternalLink, Github, AlertCircle, Check } from 'lucide-astro';

interface Props {
  project: Project;
  locale: string;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const data = localiseProject(project, locale);

const allProjects = await getProjects();
const { previous, next } = getProjectNeighbours(allProjects, project);

const techGroups = groupByLayer(resolveTechs(data.technologies));
const origin = Astro.site?.origin ?? '';
const path = `/projects/${project.id}`;

/** Metadata pairs shown under the hero. Only rendered when present. */
const metaItems = [
  data.year && { label: t.project.year, value: data.year },
  data.client && { label: t.project.client, value: data.client },
  data.status && { label: t.project.status, value: data.status },
  data.team && { label: t.project.team, value: data.team },
].filter(Boolean) as { label: string; value: string }[];

const sections = [
  data.problem && { title: t.project.problem, body: data.problem },
  data.solution && { title: t.project.solution, body: data.solution },
  data.role && { title: t.project.role, body: data.role },
].filter(Boolean) as { title: string; body: string }[];
---

<BaseLayout
  title={data.title}
  description={data.summary}
  path={path}
  locale={locale}
  type="article"
  image={data.cover?.src}
  schema={[
    projectSchema(
      origin,
      { title: data.title, summary: data.summary, technologies: data.technologies },
      localePath(locale, path),
    ),
    breadcrumbSchema(origin, [
      { name: t.nav.home, path: '/' },
      { name: t.meta.projectsTitle, path: '/projects' },
      { name: data.title, path },
    ]),
  ]}
>
  <article>
    <!-- Hero -->
    <header class="relative overflow-hidden border-b border-line">
      <div
        class="dot-grid pointer-events-none absolute inset-0 opacity-50 [mask-image:linear-gradient(to_bottom,black,transparent)]"
        aria-hidden="true"
      ></div>

      <div class="container-page relative py-12 md:py-16">
        <a
          href={localePath(locale, '/projects')}
          class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent"
        >
          <ArrowLeft size={15} aria-hidden="true" />
          {t.project.backToProjects}
        </a>

        <div class="mt-8 flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-10">
          {data.logo && (
            <Image
              src={data.logo}
              alt={`${data.title} logo`}
              width={72}
              height={72}
              class="size-16 shrink-0 rounded-xl border border-line bg-surface object-contain p-2 md:size-18"
            />
          )}

          <div class="min-w-0 flex-1">
            {data.categories.length > 0 && (
              <p class="font-mono text-xs tracking-wider text-muted uppercase">
                {data.categories.join(' · ')}
              </p>
            )}

            <h1 class="mt-3 text-[length:var(--text-display)] leading-[1.05]">{data.title}</h1>
            <p class="mt-4 max-w-2xl text-[length:var(--text-lead)] leading-relaxed text-muted">
              {data.tagline}
            </p>

            {(data.links.demo || data.links.repo || data.links.extra.length > 0) && (
              <div class="mt-7 flex flex-wrap gap-3">
                {data.links.demo && (
                  <Button href={data.links.demo} external>
                    <ExternalLink size={16} aria-hidden="true" />
                    {t.project.liveDemo}
                  </Button>
                )}
                {data.links.repo && (
                  <Button href={data.links.repo} variant="secondary" external>
                    <Github size={16} aria-hidden="true" />
                    {t.project.viewCode}
                  </Button>
                )}
                {data.links.extra.map((link) => (
                  <Button href={link.url} variant="secondary" external>
                    <ExternalLink size={16} aria-hidden="true" />
                    {link.label}
                  </Button>
                ))}
              </div>
            )}
          </div>
        </div>

        {metaItems.length > 0 && (
          <dl class="mt-10 grid gap-5 border-t border-line pt-6 sm:grid-cols-2 lg:grid-cols-4">
            {metaItems.map((item) => (
              <div>
                <dt class="font-mono text-[11px] tracking-wider text-muted uppercase">
                  {item.label}
                </dt>
                <dd class="mt-1 text-sm font-medium">{item.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <!-- Stack and repository status sit here rather than in a sidebar, so the
             body below can use the full width. A six-layer architecture diagram
             squeezed into a narrow column is unreadable, and legibility wins. -->
        <div class="mt-8 grid gap-6 border-t border-line pt-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
          {techGroups.length > 0 && (
            <div>
              <h2 class="font-mono text-[11px] tracking-wider text-muted uppercase">
                {t.project.technologies}
              </h2>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {techGroups.flatMap((group) =>
                  group.items.map((tech) => <TechChip tech={tech} size="sm" />),
                )}
              </div>
            </div>
          )}
          <RepoBadge status={data.repoStatus} url={data.links.repo} locale={locale} />
        </div>
      </div>
    </header>

    <!-- Draft notice: says plainly that the case study is unfinished rather than
         padding it with invented detail. -->
    {data.draft && (
      <div class="container-page pt-8">
        <p class="flex items-start gap-3 rounded-[var(--radius-card)] border border-line bg-surface-2 p-4 text-sm text-muted">
          <AlertCircle size={17} class="mt-0.5 shrink-0" aria-hidden="true" />
          {t.projects.draftNotice}
        </p>
      </div>
    )}

    <div class="container-page py-14 md:py-20">
      <div>
        <div class="min-w-0 space-y-14 md:space-y-20">
          {sections.map((section) => (
            <section class="reveal">
              <h2 class="font-display text-[length:var(--text-h3)] font-semibold">
                {section.title}
              </h2>
              <p class="mt-4 max-w-2xl leading-relaxed text-muted">{section.body}</p>
            </section>
          ))}

          {data.architecture && data.architecture.nodes.length > 0 && (
            <section>
              <h2 class="reveal font-display text-[length:var(--text-h3)] font-semibold">
                {t.project.architecture}
              </h2>
              <div class="mt-6">
                <ArchitectureDiagram
                  nodes={data.architecture.nodes}
                  edges={data.architecture.edges}
                  note={data.architecture.note}
                  title={`${t.project.architecture} — ${data.title}`}
                />
              </div>

              {/* Text equivalent of the diagram: the only version a screen
                    reader can follow, and it stays useful if the SVG fails. */}
              <ul class="reveal mt-6 grid gap-2 sm:grid-cols-2">
                {data.architecture.nodes.map((node) => (
                  <li class="text-sm text-muted">
                    <span class="font-medium text-ink">{node.label}</span>
                    {node.description && <span> — {node.description}</span>}
                  </li>
                ))}
              </ul>
            </section>
          )}

          {data.features.length > 0 && (
            <section>
              <h2 class="reveal font-display text-[length:var(--text-h3)] font-semibold">
                {t.project.features}
              </h2>
              <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {data.features.map((feature, i) => (
                  <li
                    class={`reveal reveal-delay-${i % 3} rounded-[var(--radius-card)] border border-line bg-surface p-5`}
                  >
                    <div class="flex items-start gap-3">
                      <span
                        class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent"
                        aria-hidden="true"
                      >
                        <Check size={13} />
                      </span>
                      <div class="min-w-0">
                        <h3 class="text-sm font-semibold">{feature.title}</h3>
                        {feature.description && (
                          <p class="mt-1.5 text-sm leading-relaxed text-muted">
                            {feature.description}
                          </p>
                        )}
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {data.highlights.length > 0 && (
            <section>
              <h2 class="reveal font-display text-[length:var(--text-h3)] font-semibold">
                {t.project.highlights}
              </h2>
              <ol class="mt-6 grid gap-5 lg:grid-cols-2 lg:gap-x-10">
                {data.highlights.map((highlight, i) => (
                  <li class="reveal border-l-2 border-accent pl-5">
                    <span class="font-mono text-xs text-muted">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <h3 class="font-display mt-1.5 text-base font-semibold">{highlight.title}</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
                      {highlight.description}
                    </p>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {/* Results only render when there is something verifiable to show. */}
          {data.results.length > 0 && (
            <section>
              <h2 class="reveal font-display text-[length:var(--text-h3)] font-semibold">
                {t.project.results}
              </h2>
              <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {data.results.map((result) => (
                  <div class="reveal rounded-[var(--radius-card)] border border-line bg-surface p-5">
                    {result.value && (
                      <dt class="font-display text-2xl font-semibold text-accent">
                        {result.value}
                      </dt>
                    )}
                    <dd class="mt-1 text-sm text-muted">{result.label}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          <section>
            <h2 class="reveal font-display text-[length:var(--text-h3)] font-semibold">
              {t.project.gallery}
            </h2>
            <div class="mt-6">
              <Gallery
                items={data.gallery}
                emptyTitle={t.project.galleryPending}
                emptyNote={t.project.galleryPendingNote}
                closeLabel={t.project.closeImage}
                columns={3}
              />
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- Previous / next -->
    {(previous || next) && (
      <nav class="border-t border-line" aria-label={t.projects.sectionTitle}>
        <div class="container-page grid gap-4 py-10 sm:grid-cols-2">
          {previous && (
            <a
              href={localePath(locale, `/projects/${previous.id}`)}
              class="group rounded-[var(--radius-card)] border border-line bg-surface p-5 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent"
            >
              <span class="inline-flex items-center gap-2 font-mono text-xs text-muted uppercase">
                <ArrowLeft size={13} aria-hidden="true" />
                {t.project.previous}
              </span>
              <span class="font-display mt-2 block font-semibold group-hover:text-accent">
                {localiseProject(previous, locale).title}
              </span>
            </a>
          )}
          {next && (
            <a
              href={localePath(locale, `/projects/${next.id}`)}
              class="group rounded-[var(--radius-card)] border border-line bg-surface p-5 text-right transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent sm:col-start-2"
            >
              <span class="inline-flex items-center gap-2 font-mono text-xs text-muted uppercase">
                {t.project.next}
                <ArrowRight size={13} aria-hidden="true" />
              </span>
              <span class="font-display mt-2 block font-semibold group-hover:text-accent">
                {localiseProject(next, locale).title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>
