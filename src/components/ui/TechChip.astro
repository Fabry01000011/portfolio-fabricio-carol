---
import type { Tech } from '../../data/tech';

/**
 * A technology shown as a labelled chip with a layer-coloured dot.
 * Deliberately not a logo: a wall of brand logos says nothing about depth.
 *
 * The dot reads its colour from a theme token rather than a fixed hex, so the
 * bright Monokai hues of dark mode become their darker counterparts on paper.
 * The label carries the meaning; the dot only groups.
 */
interface Props {
  tech: Tech;
  size?: 'sm' | 'md';
}

const { tech, size = 'md' } = Astro.props;

const sizes = {
  sm: 'px-2.5 py-1 text-xs gap-1.5',
  md: 'px-3 py-1.5 text-sm gap-2',
};
---

<span
  class={`inline-flex items-center rounded-full border border-line bg-surface font-mono text-ink ${sizes[size]}`}
>
  <span
    class="size-1.5 shrink-0 rounded-full"
    style={`background-color: var(--color-layer-${tech.layer})`}
    aria-hidden="true"></span>
  {tech.name}
</span>
