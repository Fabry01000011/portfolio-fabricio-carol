---
import { useTranslations } from '../../i18n';
import { site, aeon, whatsappLink } from '../../data/site';
import SectionHeader from '../ui/SectionHeader.astro';
import { Mail, MessageCircle, Linkedin, Github, Instagram, MapPin } from 'lucide-astro';

interface Props {
  locale: string;
  index?: string;
  as?: 'h1' | 'h2';
}

const { locale, index = '06', as = 'h2' } = Astro.props;
const t = useTranslations(locale);

const channels = [
  {
    icon: Mail,
    label: t.contact.emailLabel,
    value: site.email,
    href: `mailto:${site.email}`,
    external: false,
  },
  {
    icon: MessageCircle,
    label: t.contact.whatsappPersonal,
    value: site.whatsappDisplay,
    href: whatsappLink(site.whatsapp, t.contact.whatsappMessage),
    external: true,
  },
  {
    icon: MessageCircle,
    label: t.contact.whatsappAeon,
    value: aeon.whatsappDisplay,
    href: whatsappLink(aeon.whatsapp, t.aeon.whatsappMessage),
    external: true,
  },
  {
    icon: Linkedin,
    label: t.contact.linkedinLabel,
    value: 'in/fabricio-carol',
    href: site.linkedin,
    external: true,
  },
  {
    icon: Github,
    label: t.contact.githubLabel,
    value: site.githubUser,
    href: site.github,
    external: true,
  },
  {
    icon: Instagram,
    label: t.contact.instagramLabel,
    value: site.instagramHandle,
    href: site.instagram,
    external: true,
  },
];
---

<section class="container-page py-16 md:py-24" id="contacto">
  <SectionHeader index={index} title={t.contact.sectionTitle} lead={t.contact.lead} as={as} />

  <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {channels.map((channel, i) => (
      <li class={`reveal reveal-delay-${i % 3}`}>
        <a
          href={channel.href}
          class="flex h-full items-center gap-4 rounded-[var(--radius-card)] border border-line bg-surface p-4 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent"
          {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span
            class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-surface-2 text-accent"
            aria-hidden="true"
          >
            <channel.icon size={18} />
          </span>
          <span class="min-w-0">
            <span class="block font-mono text-[11px] tracking-wider text-muted uppercase">
              {channel.label}
            </span>
            <span class="mt-0.5 block truncate text-sm font-medium">{channel.value}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="reveal mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted">
    <span class="inline-flex items-center gap-2">
      <MapPin size={15} aria-hidden="true" />
      {site.location.city}, {site.location.country} · {site.location.secondary}
    </span>
    <span>{t.contact.responseNote}</span>
  </div>
</section>
