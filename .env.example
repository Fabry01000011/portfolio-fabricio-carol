# Keystatic (panel de administración en /keystatic)
#
# En desarrollo no hace falta ninguna variable: el panel corre en modo local y
# edita los archivos del proyecto directamente.
#
# Para el panel en producción hay que pasar a modo GitHub. Entrá a /keystatic en
# el sitio desplegado, seguí el asistente "Create GitHub App", y copiá acá los
# cuatro valores que genera. Después cargá las mismas variables en Vercel.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
